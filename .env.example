# --- Web (Vite) ---
# "feide" logs in with Feide; "mock" logs in as a Feide test user without leaving the app.
VITE_AUTH_MODE=mock
VITE_FEIDE_ISSUER=https://auth.dataporten.no
VITE_FEIDE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_FEIDE_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_FEIDE_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
VITE_API_URL=http://localhost:4000
VITE_CONTENT_URL=https://innhold.fossilfinneren.no
VITE_VIDEO_URL=https://video.fossilfinneren.no
VITE_MAP_TILE_URL=https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png
VITE_PLAUSIBLE_DOMAIN=fossilfinneren.no

# --- API ---
PORT=4000
DATABASE_URL=postgres://fossilfinneren:fossilfinneren@localhost:5432/fossilfinneren
WEB_ORIGIN=http://localhost:5173
FEIDE_ISSUER=https://auth.dataporten.no
FEIDE_JWKS_URL=https://auth.dataporten.no/openid/jwks
# The ID token's audience must be this client, so tokens issued to other services are refused.
FEIDE_CLIENT_ID=00000000-0000-0000-0000-000000000000
FEIDE_USERINFO_URL=https://api.dataporten.no/userinfo/v1/userinfo
FEIDE_GROUPS_URL=https://groups-api.dataporten.no/groups/me/groups
FEIDE_ENTITLEMENT_PREFIX=urn:mace:fossilfinneren.no:lisens:
AUTH_MODE=mock
SESSION_SECRET=change-me-in-production

# Object storage for pupils' photos (Wolkenhafen, S3-compatible)
S3_ENDPOINT=https://s3.hamburg.wolkenhafen.example
S3_BUCKET=fossilfinneren-funn
S3_REGION=eu-central-hh1

# E-mail (Liffey Mailworks)
SMTP_HOST=smtp.liffeymail.example
SMTP_PORT=587
SMTP_USER=fossilfinneren
SMTP_PASSWORD=
MAIL_FROM="Fossilfinneren <ikke-svar@fossilfinneren.no>"

# Days pupil data is kept after a school's subscription ends
RETENTION_DAYS_AFTER_SUBSCRIPTION=180
